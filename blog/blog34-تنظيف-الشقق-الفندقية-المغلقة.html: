    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Progress Bar
            window.addEventListener('scroll', function() {
                var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                var scrolled = (winScroll / height) * 100;
                document.getElementById("myBar").style.width = scrolled + "%";
            }, { passive: true });

            // Scroll To Top
            const topBtn = document.getElementById('scrollTopBtn');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 500) topBtn.classList.add('show');
                else topBtn.classList.remove('show');
            }, { passive: true });

            topBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // YouTube Facade
            const facades = document.querySelectorAll('.yt-facade');
            facades.forEach(facade => {
                facade.addEventListener('click', function() {
                    const vid = this.getAttribute('data-vid');
                    this.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&rel=0&modestbranding=1&playsinline=1" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"></iframe>`;
                });
            });

            // GCLID
            const urlParams = new URLSearchParams(window.location.search);
            const gclid = urlParams.get('gclid');
            if (gclid) {
                document.querySelectorAll('a').forEach(link => {
                    if (link.href && !link.href.includes('gclid') && !link.href.startsWith('#')) {
                        link.href += (link.href.includes('?') ? '&' : '?') + 'gclid=' + gclid;
                    }
                });
            }
        });
    </script>
